<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniRover.Client</RootNamespace>
    <!-- Shared by the browser app and the desktop console: SpawnDev.RTC picks the browser or desktop WebRTC stack at runtime. -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpawnDev.RTC" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniRover.Protocol\MiniRover.Protocol.csproj" />
  </ItemGroup>

</Project>
