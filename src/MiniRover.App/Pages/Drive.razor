@implements IAsyncDisposable
@using MiniRover.Client
@using MiniRover.Protocol
@using SpawnDev.SpawnJS.JSObjects
@inject SpawnJSRuntime JS

<div class="mr-drive" data-test="drive" data-state="@_state" data-reconnects="@Reconnects">
    <div class="mr-drive-top">
        <UiButton Secondary="true" OnClick="Leave" data-test="drive-back">Back</UiButton>
        <span class="mr-car-name">@Car.Name</span>
        <span class="@(_state == "connected" ? "mr-ok" : "mr-muted")" data-test="drive-status">@_status</span>
        <UiButton Secondary="true" OnClick="ToggleFullscreen" data-test="btn-fullscreen">@(_fullscreen ? "Exit full screen" : "Full screen")</UiButton>
    </div>

    <div class="mr-hud" data-test="drive-hud">
        <span class="@BatteryClass" title="Battery" data-test="hud-battery" data-volts="@(_t?.BatteryMillivolts ?? 0)">
            @BatteryText
        </span>
        <span class="@WifiClass" title="The car's WiFi signal" data-test="hud-wifi" data-rssi="@(_t?.Rssi ?? 0)">@WifiText</span>
        <span title="Video frames per second sent by the car" data-test="hud-video">video @(_t?.VideoFps.ToString() ?? "-") fps</span>
        <span title="Light sensor">light @(_t?.Light.ToString() ?? "-")</span>
        <span title="Line sensors (left, middle, right)" data-test="hud-line">line @LineText</span>
        <span title="Telemetry from the car per second" data-test="hud-rate">@(_rate < 0 ? "-" : _rate.ToString())/s</span>
        <span title="Time for a command to reach the car and come back" data-test="hud-rtt" data-rtt="@(_link?.RoundTripMs ?? -1)">@RttText</span>
        <span data-test="hud-moving" data-moving="@((_t?.Moving ?? false) ? "1" : "0")">@((_t?.Moving ?? false) ? "moving" : "stopped")</span>
        <span title="Free internal memory on the car">heap @(_t?.FreeHeapKb.ToString() ?? "-") KB</span>
    </div>

    @if (WifiSignal.Warning(_t?.Rssi ?? 0) is string wifiWarning)
    {
        <div class="mr-banner mr-warn" data-test="drive-wifi-warning">@wifiWarning</div>
    }
    @if (_t != null && !_t.NoBattery && _t.BatteryLevel >= 2)
    {
        <div class="mr-banner mr-error" data-test="drive-battery-warning">Batteries empty: the car has stopped its motors to protect the cells. Charge or replace them.</div>
    }
    else if (_t != null && !_t.NoBattery && _t.BatteryLevel == 1)
    {
        <div class="mr-banner mr-warn" data-test="drive-battery-warning">Batteries low: drive the car back now. It slows down to make them last.</div>
    }
    else if (_t != null && _t.NoBattery)
    {
        <div class="mr-banner mr-warn" data-test="drive-battery-warning">The battery switch is off (USB power only): the wheels and camera servos will not move.</div>
    }

    <VideoView Channel="_video" Car="Car" FaceTracking="_faceTracking" OnFace="OnFace" />

    <div class="mr-controls">
        <Stick Label="Drive" TestId="stick-drive" OnMove="OnDriveStick" />
        <div class="mr-buttons">
            <UiButton OnClick="Horn" data-test="btn-horn">Horn</UiButton>
            <UiButton Secondary="@(_lightsIndex == 0)" OnClick="ToggleLights" data-test="btn-lights" data-mode="@LightModes[_lightsIndex].Mode">Lights: @LightModes[_lightsIndex].Name</UiButton>
            <UiButton Secondary="true" OnClick="CenterCamera" data-test="btn-center">Center camera</UiButton>
            <UiButton Secondary="true" OnClick="CycleSpeed" data-test="btn-speed">Speed: @SpeedName</UiButton>
            <UiButton Secondary="@(!_faceTracking)" OnClick="ToggleFaceTracking" data-test="btn-face">Follow my face</UiButton>
            <UiButton Secondary="@(!_showEyes)" OnClick="@(() => _showEyes = !_showEyes)" data-test="btn-eyes">Eyes</UiButton>
            <UiButton Secondary="@(!_showSettings)" OnClick="@(() => _showSettings = !_showSettings)" data-test="btn-settings">Settings</UiButton>
        </div>
        <Stick Label="Camera" TestId="stick-camera" SpringBack="false" OnMove="OnCameraStick" />
    </div>
    @if (_showEyes && _link != null && _state == "connected")
    {
        <EyesPanel Link="_link" />
    }
    @if (_showSettings && _link != null && _state == "connected")
    {
        <CarSettingsPanel Link="_link" Car="Car" Volts="@(_t == null ? null : _t.BatteryMillivolts / 1000.0)" OnLocalChanged="ApplyDrivingFeel" />
    }
    <p class="mr-muted mr-keys">Keyboard: W A S D or arrows to drive, Space horn, L lights, C center camera, F follow my face. Gamepad: left stick or triggers to drive, right stick aims the camera, A horn, Y lights, B center.</p>
</div>

@code {
    [Parameter, EditorRequired] public SavedCar Car { get; set; } = default!;
    /// <summary>Play mode: the car picked over Bluetooth. Each connection is signaled over BLE and runs on the car's own
    /// WiFi; null = through the internet (tracker).</summary>
    [Parameter] public CarSetupBle? Ble { get; set; }
    [Parameter] public EventCallback OnLeave { get; set; }

    // Commands go out at 20 Hz while driving; the car holds each for HoldMs and stops by itself if they stop coming
    // (tab hidden, network gone), so HoldMs is a few periods, never seconds.
    const int PeriodMs = 50;
    const int HoldMs = 300;

    CarConnection? _link;
    readonly DriveMixer _mixer = new() { SpeedLimit = 0.6 };
    readonly CancellationTokenSource _cts = new();
    CarLink.Telemetry? _t;
    SpawnDev.RTC.IRTCDataChannel? _video;
    string _state = "connecting", _status = "connecting...";
    int _rate = -1, _frames; // -1 until the first full second has been counted
    bool _wasDriving;

    // input state
    (double X, double Y) _touch;
    readonly HashSet<string> _keys = new();
    double _pan = 90, _tilt = 90, _sentPan = -1, _sentTilt = -1;
    bool _padA, _padY, _padB;

    Window? _window;

    static readonly (string Name, double Limit)[] Speeds = [("slow", 0.35), ("normal", 0.6), ("fast", 1.0)];
    int _speed = 1;
    string SpeedName => Speeds[_speed].Name;

    string BatteryText => _t == null ? "battery -" : _t.NoBattery ? "battery off" :
        $"{BatteryGauge.Percent(_t.BatteryMillivolts / 1000.0)}% {_t.BatteryMillivolts / 1000.0:F2} V" +
        (_battery.MinutesLeft is double left ? $" (about {(left >= 90 ? $"{left / 60:F1} h" : $"{left:F0} min")} left)" : "");
    string RttText => _link == null || _link.RoundTripMs < 0 ? "link -" : $"link {_link.RoundTripMs} ms";

    readonly BatteryEstimator _battery = new();
    readonly System.Diagnostics.Stopwatch _batteryClock = System.Diagnostics.Stopwatch.StartNew();
    bool _fullscreen;
    WakeLockSentinel? _wakeLock;
    Document? _document;

    async Task ToggleFullscreen()
    {
        try
        {
            if (_fullscreen)
            {
                await _document!.ExitFullscreen();
                _fullscreen = false;
            }
            else
            {
                using var root = _document!.DocumentElement;
                if (root != null) await root.RequestFullscreen();
                _fullscreen = true;
            }
        }
        catch (Exception ex) { Console.WriteLine("Full screen: " + ex.Message); }
    }

    /// <summary>Keeps the screen on while driving (a dimming screen mid-drive is no fun). The browser drops the lock
    /// whenever the tab is hidden, so it is taken again when the tab comes back.</summary>
    async Task KeepScreenOn()
    {
        if (_wakeLock != null && !_wakeLock.Released) return;
        try
        {
            using var navigator = _window!.Navigator;
            using var wakeLock = navigator.WakeLock;
            if (wakeLock == null) return; // not supported here
            _wakeLock?.Dispose();
            _wakeLock = await wakeLock.Request("screen");
        }
        catch (Exception ex) { Console.WriteLine("Wake lock: " + ex.Message); }
    }

    // Hidden tab (switched app, locked screen): stop the car now rather than wait for its deadman, and forget held
    // keys and fingers. Visible again: take the screen wake lock again.
    void OnVisibilityChange(Event e)
    {
        e.Dispose();
        string state;
        try { state = _document!.VisibilityState; } catch { return; }
        if (state == "hidden")
        {
            _keys.Clear();
            _touch = default;
            try { if (_link?.IsConnected == true) _link.Stop(); } catch { }
        }
        else
        {
            _ = KeepScreenOn();
        }
    }
    string BatteryClass => _t == null ? "mr-muted" : _t.BatteryLevel >= 2 || _t.NoBattery ? "mr-error" : _t.BatteryLevel == 1 ? "mr-warn" : "mr-ok";
    string WifiText => _t == null || WifiSignal.Bars(_t.Rssi) < 0 ? "wifi -" :
        $"wifi {new string('|', WifiSignal.Bars(_t.Rssi))}{new string('.', 4 - WifiSignal.Bars(_t.Rssi))} {_t.Rssi} dBm";
    string WifiClass => _t == null || WifiSignal.Bars(_t.Rssi) < 0 ? "mr-muted" : WifiSignal.Bars(_t.Rssi) switch { 0 => "mr-error", 1 => "mr-warn", _ => "mr-ok" };
    string LineText => _t == null ? "-" : $"{((_t.Line & 1) != 0 ? "#" : "_")}{((_t.Line & 2) != 0 ? "#" : "_")}{((_t.Line & 4) != 0 ? "#" : "_")}";

    bool _showSettings, _showEyes;

    /// <summary>Per-car steering sensitivity and stick curve (Settings page).</summary>
    void ApplyDrivingFeel()
    {
        _mixer.SteerGain = Car.SteerGain;
        _mixer.Expo = Car.Expo;
    }

    protected override void OnInitialized()
    {
        ApplyDrivingFeel();
        _window = JS.Get<Window>("window");
        _window.OnKeyDown += OnKeyDown;
        _window.OnKeyUp += OnKeyUp;
        _window.OnBlur += OnBlur;
        _document = _window.Document;
        _document.OnVisibilityChange += OnVisibilityChange;
        _ = KeepScreenOn();
        _ = RunAsync();
    }

    /// <summary>
    /// Connect, drive until the link drops, reconnect: switching the car off and on, a WiFi blip or driving out of range
    /// and back all recover by themselves. Only a pairing-key failure stops for good (retrying cannot fix it).
    /// </summary>
    async Task RunAsync()
    {
        int attempt = 0;
        while (!_cts.IsCancellationRequested)
        {
            attempt++;
            try
            {
                _link = Ble != null
                    ? new CarConnection(Convert.FromHexString(Car.RoomKeyHex), null, "") // no internet: host candidates only
                    : CarConnection.FromKeyHex(Car.RoomKeyHex, string.IsNullOrWhiteSpace(Car.TrackerUrl) ? null : Car.TrackerUrl);
                _link.OnStatus += s => { if (_state != "connected") { _status = s; _ = InvokeAsync(StateHasChanged); } };
                _link.OnTelemetry += t => { _t = t; _frames++; };
                _link.OnVideoChannel += ch => { _video = ch; _ = InvokeAsync(StateHasChanged); };
                _state = attempt == 1 ? "connecting" : "reconnecting";
                _status = attempt == 1 ? "looking for " + Car.Name + "... (is it switched on?)" : "connection lost, reconnecting to " + Car.Name + "...";
                StateHasChanged();
                using (var timeout = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token))
                {
                    timeout.CancelAfter(TimeSpan.FromSeconds(90));
                    if (Ble != null)
                    {
                        if (!Ble.Connected) await Ble.ConnectAsync(); // the device picked in the garage: no picker
                        // BLE is let go as soon as the car took the answer: the session runs on WiFi, and the car's one
                        // radio does the WiFi handshake better without a BLE connection beside it. The next (re)connect
                        // opens BLE again without a picker.
                        var ble = Ble;
                        await _link.ConnectOverBleAsync(new CarBleSignaling(ble, Convert.FromHexString(Car.RoomKeyHex)), timeout.Token,
                            () => { ble.Disconnect(); return Task.CompletedTask; });
                    }
                    else
                    {
                        await _link.ConnectAsync(timeout.Token);
                    }
                }
                _state = "connected";
                _status = attempt == 1 ? "connected" : "connected (reconnected)";
                Reconnects = attempt - 1;
                _video = _link.VideoChannel ?? _video;
                _link.Video(true); // the car's saved size / quality / fps
                ApplyTestHooks();
                _sentPan = _sentTilt = -1; // resend the camera aim to a car that may have restarted
                if (_lightsIndex != 0) ApplyLights(); // a restarted car comes back with its default lights
                StateHasChanged();
                await ControlLoop();
            }
            catch (OperationCanceledException) when (_cts.IsCancellationRequested) { return; }
            catch (Exception ex) when (ex.Message.Contains("pairing key"))
            {
                _state = "failed";
                _status = ex.Message + ". Pair this car again (Add a car).";
                StateHasChanged();
                return;
            }
            catch (Exception ex)
            {
                _status = ex is OperationCanceledException
                    ? (Ble != null ? "the car did not answer yet. Is it on, in play mode, and is this device on its WiFi? Still trying..."
                                   : "the car did not answer yet. Is it on and on WiFi? Still trying...")
                    : ex.Message + ", retrying...";
                StateHasChanged();
            }
            finally
            {
                // Release the old connection before the next attempt (the car accepts one app at a time).
                var old = _link;
                _link = null;
                _video = null;
                _wasDriving = false;
                if (old != null) await old.DisposeAsync();
            }
            if (_cts.IsCancellationRequested) return;
            try { await Task.Delay(1000, _cts.Token); } catch (OperationCanceledException) { return; }
        }
    }

    /// <summary>
    /// Test hook: <c>?testloss=50</c> in the page address asks the car to drop 50 per mille of the datagrams it sends
    /// this session, to check that video and controls survive a lossy network (retransmission + FORWARD-TSN).
    /// </summary>
    void ApplyTestHooks()
    {
        string search;
        try { search = JS.Get<string>("location.search") ?? ""; } catch { return; }
        var m = System.Text.RegularExpressions.Regex.Match(search, @"[?&]testloss=(\d+)");
        if (m.Success && _link != null) _link.Setting("test.loss=" + m.Groups[1].Value);
    }

    /// <summary>How many times this page reconnected (shown for tests).</summary>
    int Reconnects { get; set; }

    async Task ControlLoop()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(PeriodMs));
        var rateClock = System.Diagnostics.Stopwatch.StartNew();
        while (await timer.WaitForNextTickAsync(_cts.Token))
        {
            if (_link == null || !_link.IsConnected) { _state = "reconnecting"; StateHasChanged(); return; }
            var (throttle, steer, camX, camY) = ReadInputs();

            _mixer.SpeedLimit = Speeds[_speed].Limit;
            var (l, r) = _mixer.Mix(throttle, steer);
            if (l != 0 || r != 0)
            {
                _link.Drive(l, r, HoldMs);
                _wasDriving = true;
            }
            else if (_wasDriving)
            {
                _link.Stop(); // do not wait out the hold when the driver lets go
                _wasDriving = false;
            }

            // Camera: the touch pad aims directly; a gamepad stick moves the aim (rate control).
            if (camX != 0 || camY != 0)
            {
                _pan = Math.Clamp(_pan - camX * 3, 0, 180);   // stick right = pan right = below 90
                _tilt = Math.Clamp(_tilt + camY * 3, 80, 180); // stick up = tilt up = above 90
            }
            if (Math.Abs(_pan - _sentPan) >= 0.5 || Math.Abs(_tilt - _sentTilt) >= 0.5)
            {
                _link.Servo(_pan, _tilt);
                _sentPan = _pan;
                _sentTilt = _tilt;
            }

            if (rateClock.ElapsedMilliseconds >= 1000)
            {
                _rate = _frames;
                _frames = 0;
                rateClock.Restart();
                try { _link.Ping(); } catch (InvalidOperationException) { }
                if (_t != null && !_t.NoBattery)
                {
                    _battery.Add(_batteryClock.Elapsed.TotalMinutes, BatteryGauge.Percent(_t.BatteryMillivolts / 1000.0), _t.Moving);
                }
            }
            StateHasChanged();
        }
    }

    /// <summary>Touch wins over a gamepad, a gamepad over the keyboard: whichever the driver is using right now.</summary>
    (double Throttle, double Steer, double CamX, double CamY) ReadInputs()
    {
        double throttle = 0, steer = 0, camX = 0, camY = 0;
        if (_touch != default)
        {
            throttle = _touch.Y;
            steer = _touch.X;
        }
        else if (ReadGamepad(out var gp))
        {
            (throttle, steer, camX, camY) = gp;
        }
        else
        {
            if (_keys.Contains("w") || _keys.Contains("arrowup")) throttle += 1;
            if (_keys.Contains("s") || _keys.Contains("arrowdown")) throttle -= 1;
            if (_keys.Contains("d") || _keys.Contains("arrowright")) steer += 0.7;
            if (_keys.Contains("a") || _keys.Contains("arrowleft")) steer -= 0.7;
        }
        return (throttle, steer, camX, camY);
    }

    bool ReadGamepad(out (double, double, double, double) values)
    {
        values = default;
        using var navigator = _window!.Navigator;
        Gamepad[]? pads;
        try { pads = navigator.GetGamepads(); } catch { return false; }
        if (pads == null) return false;
        bool used = false;
        foreach (var pad in pads)
        {
            if (pad == null) continue;
            using (pad)
            {
                if (used || pad.Mapping != "standard") continue;
                double[] axes = pad.Axes;
                var buttons = pad.Buttons;
                try
                {
                    double rt = buttons.Length > 7 ? buttons[7].Value : 0, lt = buttons.Length > 6 ? buttons[6].Value : 0;
                    double stickY = axes.Length > 1 ? -axes[1] : 0;
                    double throttle = Math.Abs(rt - lt) > 0.05 ? rt - lt : stickY;
                    double steer = axes.Length > 0 ? axes[0] : 0;
                    double camX = axes.Length > 2 ? Dead(axes[2]) : 0, camY = axes.Length > 3 ? Dead(-axes[3]) : 0;
                    Edge(buttons, 0, ref _padA, Horn);
                    Edge(buttons, 3, ref _padY, ToggleLights);
                    Edge(buttons, 1, ref _padB, CenterCamera);
                    values = (throttle, steer, camX, camY);
                    used = Math.Abs(throttle) > _mixer.Deadzone || Math.Abs(steer) > _mixer.Deadzone || camX != 0 || camY != 0;
                }
                finally
                {
                    foreach (var b in buttons) b.Dispose();
                }
            }
        }
        return used;
    }

    static double Dead(double v) => Math.Abs(v) < 0.15 ? 0 : v;

    static void Edge(GamepadButton[] buttons, int i, ref bool last, Action action)
    {
        bool now = buttons.Length > i && buttons[i].Pressed;
        if (now && !last) action();
        last = now;
    }

    Task OnDriveStick((double X, double Y) v) { _touch = v; return Task.CompletedTask; }

    Task OnCameraStick((double X, double Y) v)
    {
        if (_faceTracking && (v.X != 0 || v.Y != 0)) _faceTracking = false; // the driver takes the camera back
        // The pad maps directly to angles: full left/right = 60 degrees each way, full up/down = the tilt range.
        _pan = 90 - v.X * 60;
        _tilt = Math.Clamp(90 + v.Y * 60, 80, 180);
        return Task.CompletedTask;
    }

    void OnKeyDown(KeyboardEvent e)
    {
        string k = e.Key.ToLowerInvariant();
        if (k is "arrowup" or "arrowdown" or "arrowleft" or "arrowright" or " ") e.PreventDefault(); // no page scroll
        if (!_keys.Add(k)) return; // auto-repeat
        if (k == " ") Horn();
        else if (k == "l") ToggleLights();
        else if (k == "f") ToggleFaceTracking();
        else if (k == "c") CenterCamera();
        e.Dispose();
    }

    void OnKeyUp(KeyboardEvent e)
    {
        _keys.Remove(e.Key.ToLowerInvariant());
        e.Dispose();
    }

    // Keys released while the window has no focus never send keyup: forget them so the car does not drive on.
    void OnBlur(FocusEvent e)
    {
        _keys.Clear();
        _touch = default;
        e.Dispose();
    }

    void Horn() { if (_link?.IsConnected == true) _link.Buzzer(2000, 250); }

    // The car animates these itself (LightsService). Headlights add brake lights and turn signals once the corners
    // are calibrated (Settings).
    static readonly (string Name, int Mode)[] LightModes =
    [
        // "off" first: the car starts with its lights off (they drain the batteries), so this matches it.
        ("off", CarLink.LightsOff), ("headlights", CarLink.LightsHeadlights), ("hazard", CarLink.LightsHazard),
        ("police", CarLink.LightsPolice), ("rainbow", CarLink.LightsRainbow), ("battery", CarLink.LightsBattery),
        ("dim", CarLink.LightsSolid),
    ];
    int _lightsIndex;

    void ToggleLights()
    {
        _lightsIndex = (_lightsIndex + 1) % LightModes.Length;
        ApplyLights();
    }

    void ApplyLights()
    {
        if (_link?.IsConnected != true) return;
        try { _link.Lights(LightModes[_lightsIndex].Mode, 40, 40, 40); } catch (InvalidOperationException) { }
    }

    void CenterCamera() { _faceTracking = false; _pan = 90; _tilt = 90; }

    // Face tracking: the camera servos follow the face the video view finds (BlazeFace on the GPU). The wheels
    // never move. Grabbing the camera stick or centring the camera hands control back to the driver.
    readonly FaceFollower _follower = new();
    readonly System.Diagnostics.Stopwatch _faceClock = System.Diagnostics.Stopwatch.StartNew();
    bool _faceTracking;

    void ToggleFaceTracking()
    {
        _faceTracking = !_faceTracking;
        _follower.Reset();
    }

    void OnFace(FaceSighting? face)
    {
        if (!_faceTracking || face is not FaceSighting f) return;
        (_pan, _tilt) = _follower.Update(_pan, _tilt, f.X, f.Y, _faceClock.Elapsed);
    }

    void CycleSpeed() => _speed = (_speed + 1) % Speeds.Length;

    async Task Leave()
    {
        await DisposeAsync();
        await OnLeave.InvokeAsync();
    }

    bool _disposed;
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        // Stop the car first: cancelling can run the connect loop's cleanup at once and release the link.
        var link = _link;
        try { if (link?.IsConnected == true) { link.Stop(); link.Video(false); } } catch { }
        _cts.Cancel();
        if (_window != null)
        {
            _window.OnKeyDown -= OnKeyDown;
            _window.OnKeyUp -= OnKeyUp;
            _window.OnBlur -= OnBlur;
            if (_document != null)
            {
                _document.OnVisibilityChange -= OnVisibilityChange;
                if (_fullscreen) { try { await _document.ExitFullscreen(); } catch { } }
                _document.Dispose();
            }
            if (_wakeLock != null)
            {
                try { if (!_wakeLock.Released) await _wakeLock.Release(); } catch { }
                _wakeLock.Dispose();
            }
            _window.Dispose();
        }
        if (link != null) await link.DisposeAsync(); // idempotent: the loop's cleanup may have done it already
        if (Ble != null) await Ble.DisposeAsync(); // play mode: the drive page owns the Bluetooth device it was given
    }
}
