@implements IDisposable
@using MiniRover.Client
@using System.Globalization
@inject CarStore Cars

@* Car settings over the live link. Values shown are what the car reports (it clamps everything to safe ranges).
   Slider changes are sent after a short pause so dragging does not write the car's flash many times a second. *@
<div class="mr-settings" data-test="settings">
    @if (_s == null)
    {
        <p class="mr-muted">Reading the car's settings...</p>
    }
    else
    {
        <section>
            <h3>Driving</h3>
            <label>Top speed: @Pct(_s.GetDouble("drive.limit", 1))
                <UiSlider Min="0.2" Max="1" Step="0.05" Value="@_s.GetDouble("drive.limit", 1)" ValueChanged="@(v => Queue("drive.limit", v))" data-test="set-drive-limit" />
            </label>
            <p class="mr-muted">The car never goes faster than this, whatever the app's speed button says. Good for younger drivers.</p>
            <label>Steering sensitivity: @Pct(Car.SteerGain)
                <UiSlider Min="0.3" Max="1" Step="0.05" Value="@Car.SteerGain" ValueChanged="@(v => SetLocal(c => c.SteerGain = v))" />
            </label>
            <label>Stick curve (fine control near the center): @Pct(Car.Expo)
                <UiSlider Min="0" Max="0.8" Step="0.05" Value="@Car.Expo" ValueChanged="@(v => SetLocal(c => c.Expo = v))" />
            </label>
        </section>

        <section>
            <h3>Camera @(SensorName)</h3>
            <label>Picture size
                <select value="@_s.Get("camera.size")" @onchange="@(e => Send("camera.size", e.Value?.ToString()))" data-test="set-camera-size">
                    @foreach (var (value, text) in Sizes)
                    {
                        <option value="@value" selected="@(value == _s.Get("camera.size"))">@text</option>
                    }
                </select>
            </label>
            <label>Quality: @QualityText
                <UiSlider Min="8" Max="40" Step="1" Value="@(48 - _s.GetDouble("camera.quality", 12))" ValueChanged="@(v => Queue("camera.quality", 48 - v))" />
            </label>
            <p class="mr-muted">Higher quality means bigger pictures: fewer frames per second on a slow network.</p>
            <label>Frames per second (most): @_s.Get("camera.fps")
                <UiSlider Min="5" Max="30" Step="1" Value="@_s.GetDouble("camera.fps", 15)" ValueChanged="@(v => Queue("camera.fps", v))" />
            </label>
            <label class="mr-check"><input type="checkbox" checked="@_s.GetBool("camera.flip")" @onchange="@(e => Send("camera.flip", Bool(e)))" /> Flip upside down</label>
            <label class="mr-check"><input type="checkbox" checked="@_s.GetBool("camera.mirror")" @onchange="@(e => Send("camera.mirror", Bool(e)))" /> Mirror left/right</label>
        </section>

        <section>
            <h3>Camera aim</h3>
            <p class="mr-muted">The camera is held at its center position. Adjust until it looks straight ahead and level.</p>
            <label>Left / right: @Deg(_s.GetDouble("pan.trim", 0))
                <UiSlider Min="-30" Max="30" Step="0.5" Value="@_s.GetDouble("pan.trim", 0)" ValueChanged="@(v => Queue("pan.trim", v))" data-test="set-pan-trim" />
            </label>
            <label>Up / down: @Deg(_s.GetDouble("tilt.trim", 0))
                <UiSlider Min="-30" Max="30" Step="0.5" Value="@_s.GetDouble("tilt.trim", 0)" ValueChanged="@(v => Queue("tilt.trim", v))" />
            </label>
        </section>

        <section>
            <h3>Wheels</h3>
            <p class="mr-muted">Lift the car so the wheels are off the ground. Press Test: that wheel should roll <b>forward</b> for a moment.
               If it rolls backward, tick Reversed. If the car drifts to one side when driving straight, lower the faster side's balance a little.</p>
            @for (int m = 0; m < 4; m++)
            {
                int motor = m;
                <div class="mr-wheel" data-test="@($"wheel-{motor}")">
                    <span class="mr-wheel-name">@WheelNames[motor]</span>
                    <UiButton Secondary="true" OnClick="@(() => TestWheel(motor))" data-test="@($"wheel-test-{motor}")">Test</UiButton>
                    <label class="mr-check"><input type="checkbox" checked="@_s.GetBool($"motor{motor}.invert")" @onchange="@(e => Send($"motor{motor}.invert", Bool(e)))" /> Reversed</label>
                    <label class="mr-wheel-gain">Balance @Pct(_s.GetDouble($"motor{motor}.gain", 1))
                        <UiSlider Min="0.7" Max="1.3" Step="0.01" Value="@_s.GetDouble($"motor{motor}.gain", 1)" ValueChanged="@(v => Queue($"motor{motor}.gain", v))" />
                    </label>
                </div>
            }
        </section>

        <section>
            <h3>Battery</h3>
            <p>The car reads @(Volts?.ToString("F2", CultureInfo.InvariantCulture) ?? "-") V.
               To make it exact, measure the pack with a multimeter and enter the reading.</p>
            <div class="mr-row">
                <UiInput @bind-Value="_measured" inputmode="decimal" placeholder="e.g. 7.95" data-test="battery-measured" />
                <UiButton Secondary="true" OnClick="CalibrateBattery" data-test="battery-calibrate">Calibrate</UiButton>
            </div>
            @if (_batteryMessage != null) { <p class="mr-muted">@_batteryMessage</p> }
        </section>

        <section>
            <h3>Lights</h3>
            <label>Brightness: @_s.Get("led.brightness")
                <UiSlider Min="8" Max="255" Step="1" Value="@_s.GetDouble("led.brightness", 64)" ValueChanged="@(v => Queue("led.brightness", v))" />
            </label>
            <p class="mr-muted">Headlights, brake lights and turn signals need to know which corner each light is on
               (@(CornersKnown ? "done" : "not set yet")).</p>
            @if (_calStep < 0)
            {
                <div class="mr-row">
                    <UiButton Secondary="true" OnClick="@(() => StartCalibration(false))" data-test="lights-calibrate">Find the corners</UiButton>
                    <UiButton Secondary="true" OnClick="@(() => StartCalibration(true))">One light at a time</UiButton>
                </div>
            }
            else
            {
                <p data-test="lights-cal-step">@(_calSingle ? $"Light {_calStep + 1} of 12" : $"Group {_calStep + 1} of 4") is lit white. Which corner of the car is it on?</p>
                <div class="mr-corners">
                    <UiButton OnClick="@(() => Answer('0'))" data-test="corner-0">Front left</UiButton>
                    <UiButton OnClick="@(() => Answer('1'))" data-test="corner-1">Front right</UiButton>
                    <UiButton OnClick="@(() => Answer('2'))" data-test="corner-2">Rear left</UiButton>
                    <UiButton OnClick="@(() => Answer('3'))" data-test="corner-3">Rear right</UiButton>
                </div>
                <p class="mr-muted">If the lit lights are on more than one corner, cancel and use "One light at a time".</p>
                <UiButton Secondary="true" OnClick="CancelCalibration">Cancel</UiButton>
            }
        </section>

        <section>
            <h3>Advanced</h3>
            <label class="mr-check"><input type="checkbox" checked="@_s.GetBool("http.api")" @onchange="@(e => Send("http.api", Bool(e)))" />
                Local test API (HTTP on your network, for tinkering; anyone on the network could drive the car while it is on)</label>
            <label>Signaling server (empty = default)
                <UiInput Value="@Car.TrackerUrl" ValueChanged="@((string v) => SetLocal(c => c.TrackerUrl = v.Trim()))" placeholder="wss://..." />
            </label>
            <p class="mr-muted">Firmware @_s.Get("info.firmware") · @_s.Get("info.name")
                @if (_s.Get("info.faults").Length > 0) { <span class="mr-warn"> · faults: @_s.Get("info.faults")</span> }</p>
        </section>
        @if (_lastReply != null) { <p class="mr-muted" data-test="settings-reply">@_lastReply</p> }
    }
</div>

@code {
    [Parameter, EditorRequired] public CarConnection Link { get; set; } = default!;
    [Parameter, EditorRequired] public SavedCar Car { get; set; } = default!;
    /// <summary>Latest battery reading from telemetry (volts).</summary>
    [Parameter] public double? Volts { get; set; }
    /// <summary>The page's driving feel changed (steering / curve).</summary>
    [Parameter] public EventCallback OnLocalChanged { get; set; }

    static readonly string[] WheelNames = ["Front left", "Rear left", "Front right", "Rear right"];
    static readonly (string Value, string Text)[] Sizes =
    [
        ("1", "160 x 120 (fastest)"), ("6", "320 x 240"), ("8", "400 x 296"), ("9", "480 x 320"), ("10", "640 x 480"), ("11", "800 x 600 (OV2640 only)"),
    ];

    CarSettings? _s;
    CarConnection? _subscribed;
    string? _lastReply, _measured, _batteryMessage;
    readonly Dictionary<string, double> _queued = new();
    System.Threading.Timer? _flush;

    string SensorName => _s?.Get("info.camera") switch { "38" => "(OV2640)", "155" => "(GC0308)", "0" => "(none found)", _ => "" };
    string QualityText => _s == null ? "" : (48 - _s.GetDouble("camera.quality", 12)) switch { >= 36 => "best", >= 28 => "good", >= 18 => "medium", _ => "small" };

    static string Pct(double v) => Math.Round(v * 100) + "%";
    static string Deg(double v) => v.ToString("+0.0;-0.0;0", CultureInfo.InvariantCulture) + " deg";
    static string Bool(ChangeEventArgs e) => e.Value is true || e.Value?.ToString() == "true" ? "1" : "0";

    protected override void OnParametersSet()
    {
        if (Link == _subscribed) return;
        if (_subscribed != null) { _subscribed.OnSettings -= OnSettings; _subscribed.OnText -= OnText; }
        _subscribed = Link;
        Link.OnSettings += OnSettings;
        Link.OnText += OnText;
        _s = Link.LastSettings;
        try
        {
            Link.RequestSettings();
            Link.Servo(90, 90); // hold the camera at center while the aim is adjusted
        }
        catch (InvalidOperationException) { } // not connected right now: the page reconnects
    }

    void OnSettings(CarSettings s) { _s = s; _ = InvokeAsync(StateHasChanged); }
    void OnText(string t) { _lastReply = "Car: " + t; _ = InvokeAsync(StateHasChanged); }

    void Send(string key, string? value)
    {
        if (value == null) return;
        try
        {
            Link.Setting(key + "=" + value);
            if (key.StartsWith("camera.")) Link.Video(true); // restart the stream with the new size / fps
        }
        catch (InvalidOperationException) { _lastReply = "Not connected: the change was not sent."; }
    }

    void Queue(string key, double value)
    {
        _queued[key] = value;
        _flush ??= new System.Threading.Timer(_ => InvokeAsync(Flush), null, System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        _flush.Change(400, System.Threading.Timeout.Infinite);
    }

    void Flush()
    {
        foreach (var (key, value) in _queued.ToArray())
        {
            Send(key, value.ToString("0.###", CultureInfo.InvariantCulture));
            if (key is "pan.trim" or "tilt.trim") { try { Link.Servo(90, 90); } catch { } }
        }
        _queued.Clear();
    }

    async Task SetLocal(Action<SavedCar> change)
    {
        change(Car);
        Cars.Save(Car);
        await OnLocalChanged.InvokeAsync();
    }

    // ---- light corner calibration: the car lights one group (or one LED), the driver says which corner ----
    int _calStep = -1;
    bool _calSingle;
    readonly char[] _corners = "------------".ToCharArray();

    bool CornersKnown => _s != null && _s.Get("led.corners").Length == 12 && !_s.Get("led.corners").Contains('-');

    void StartCalibration(bool single)
    {
        _calSingle = single;
        _calStep = 0;
        Array.Fill(_corners, '-');
        LightStep();
    }

    void LightStep()
    {
        try { Link.Lights(MiniRover.Protocol.CarLink.LightsIdentify, param: _calSingle ? 100 + _calStep : _calStep); }
        catch (InvalidOperationException) { _lastReply = "Not connected."; _calStep = -1; }
    }

    void Answer(char corner)
    {
        if (_calSingle) _corners[_calStep] = corner;
        else for (int i = _calStep * 3; i < _calStep * 3 + 3; i++) _corners[i] = corner;
        _calStep++;
        if (_calStep < (_calSingle ? 12 : 4))
        {
            LightStep();
            return;
        }
        _calStep = -1;
        Send("led.corners", new string(_corners));
        try { Link.Lights(MiniRover.Protocol.CarLink.LightsHeadlights); } catch (InvalidOperationException) { }
    }

    void CancelCalibration()
    {
        _calStep = -1;
        try { Link.Lights(MiniRover.Protocol.CarLink.LightsSolid, 40, 40, 40); } catch (InvalidOperationException) { }
    }

    void TestWheel(int motor)
    {
        try { Link.MotorTest(motor, 45, 700); }
        catch (InvalidOperationException) { _lastReply = "Not connected."; }
    }

    void CalibrateBattery()
    {
        if (_s == null || Volts == null) return;
        if (!double.TryParse((_measured ?? "").Replace(',', '.'), NumberStyles.Float, CultureInfo.InvariantCulture, out double measured) || measured < 5 || measured > 9.5)
        {
            _batteryMessage = "Enter the pack voltage from the multimeter, between 5 and 9.5 V.";
            return;
        }
        double coef = CarSettings.CalibratedBatteryCoefficient(_s.GetDouble("battery.coef", 3.7), Volts.Value, measured);
        Send("battery.coef", coef.ToString("0.####", CultureInfo.InvariantCulture));
        _batteryMessage = $"Sent: the car now reads about {measured:F2} V (a new reading takes a few seconds).";
    }

    public void Dispose()
    {
        if (_subscribed != null) { _subscribed.OnSettings -= OnSettings; _subscribed.OnText -= OnText; }
        _flush?.Dispose();
    }
}
