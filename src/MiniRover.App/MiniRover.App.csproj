<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Standalone .NET WebAssembly app. The BlazorWebAssembly SDK is used to compile .razor files and publish;
       the page runs on SpawnDev.SpawnJS.RazorRenderer (no Blazor JavaScript runtime). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniRover.App</RootNamespace>
    <CompressionEnabled>false</CompressionEnabled>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <!-- Not a Blazor-runtime app: build the SpawnJS classic bundle (main.classic.js) that index.html loads.
         The BlazorWebAssembly SDK would otherwise switch SpawnJS.WebWorkers to its Blazor boot path. -->
    <SpawnJSWebWorkersBlazor>false</SpawnJSWebWorkersBlazor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SpawnDev.SpawnJS" Version="3.0.2" />
    <PackageReference Include="SpawnDev.SpawnJS.RazorRenderer" Version="2.2.2" />
    <PackageReference Include="SpawnDev.SpawnJS.RazorUI" Version="2.2.2" />
    <!-- Required in the exe project: its build targets produce main.classic.js. -->
    <PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.2.1" />
    <!-- Face tracking: BlazeFace on the GPU (the model is bundled in wwwroot/models, Apache-2.0, see its NOTICE). -->
    <PackageReference Include="SpawnDev.ILGPU.ML" Version="5.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniRover.Protocol\MiniRover.Protocol.csproj" />
    <ProjectReference Include="..\MiniRover.Client\MiniRover.Client.csproj" />
    <ProjectReference Include="..\MiniRover.Video\MiniRover.Video.csproj" />
  </ItemGroup>

</Project>
