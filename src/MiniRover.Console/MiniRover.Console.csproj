<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM for the WinRT Bluetooth LE APIs used by the setup command. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>minirover</AssemblyName>
    <RootNamespace>MiniRover.ConsoleApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="SpawnDev.ILGPU.ML" Version="5.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiniRover.Protocol\MiniRover.Protocol.csproj" />
    <ProjectReference Include="..\MiniRover.Client\MiniRover.Client.csproj" />
    <ProjectReference Include="..\MiniRover.Video\MiniRover.Video.csproj" />
  </ItemGroup>

</Project>
