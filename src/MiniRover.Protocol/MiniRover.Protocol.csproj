<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The same source files are compiled into the nanoFramework firmware (linked from firmware/MiniRover.Car),
         so they must stay nanoFramework-compatible: no Span, LINQ, generics or nullable annotations. -->
    <RootNamespace>MiniRover.Protocol</RootNamespace>
  </PropertyGroup>

</Project>
